# Example secrets for Streamlit Cloud deployment.
# Copy to .streamlit/secrets.toml and fill in real values.

DATABASE_URL = "postgresql://user:password@host:5432/dbname"
AUTH_SECRET = "replace-with-a-random-32-character-secret-key"
SMTP_HOST = "smtp.example.com"
SMTP_PORT = "587"
SMTP_USER = "user@example.com"
SMTP_PASSWORD = "replace-with-smtp-password"
SMTP_FROM = "noreply@example.com"
SMTP_SECURITY = "starttls"
ADMIN_EMAIL = "admin@example.com"
ADMIN_PASSWORD = "ChangeMeStrong123"
AUTH_DEV_SHOW_CODE = "0"
SIGNUP_OPEN = "1"
